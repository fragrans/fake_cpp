{
	"version": 3,
	"configurePresets": [
		{
			"name": "ninja-multi-vcpkg",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build",
			"toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "ninja-multi-vcpkg",
			"configurePreset": "ninja-multi-vcpkg"
		}
	]
}
